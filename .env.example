GEMINI_API_KEY=YOUR_API_KEY_HERE

# --- LMS(Canvas) 수집기 ---
# LMS > 계정 > 설정 > '새 액세스 토큰' 에서 발급
CANVAS_API_KEY=YOUR_CANVAS_TOKEN_HERE
CANVAS_API_URL=https://mylms.korea.ac.kr

# DB 경로 (상대경로면 프로젝트 루트 기준)
SCHEDULE_DB_PATH=workspace/data/schedule.db
LMS_RAW_DB_PATH=workspace/data/lms_raw.db

# 스케줄 (HH:MM, Asia/Seoul)
LMS_SYNC_TIME=07:00
CLEANUP_TIME=00:00

# 마감일 없는 과제도 일정에 올릴지 / 이미 마감 지난 과제는 제외할지
LMS_INCLUDE_NO_DUE=false
LMS_SKIP_PAST_DUE=true

# 비서 모델 (무료 티어, 빠른 응답: gemini-2.5-flash-lite 기본)
# GEMINI_MODEL=gemini-2.5-flash-lite
